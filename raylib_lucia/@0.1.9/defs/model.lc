public final typedef struct BoundingBox {
    final min: tuple[float; 3],
    final max: tuple[float; 3],
}

public final fun get_model_bounding_box(model: Model) -> BoundingBox:
    /// Gets the bounding box of the model.
    ///     @param model: Model - The model to get the bounding box for.
    ///     @return: BoundingBox - A BoundingBox struct containing min and max points.
    if (get_model_bounding_box_c == null):
        throw "Function 'bind_GetModelBoundingBox' not found in the loaded library." from "FunctionNotFoundError"
    end
    result: str = libload.parse_str_ptr(libload.call_fn(get_model_bounding_box_c, [model.id]))
    parts: list[str] = result.split("|")
    if (len(parts) != 6):
        throw "Invalid bounding box format returned from library." from "ValueError"
    end
    return BoundingBox {
        min = (parts[0] as float, parts[1] as float, parts[2] as float),
        max = (parts[3] as float, parts[4] as float, parts[5] as float)
    }
end

public final fun draw_bounding_box(
    bounding_box: BoundingBox,
    color: tuple[int; 4],
) -> void:
    /// Draws a bounding box defined by minimum and maximum points with the specified color.
    ///     @param bounding_box: BoundingBox - A BoundingBox struct containing min and max points.
    ///     @param color: tuple[int; 4] - A tuple of 4 integers representing RGBA color (0-255).
    ///     @return: void - No return value.
    if (draw_bounding_box_c == null):
        throw "Function 'bind_DrawBoundingBox' not found in the loaded library." from "FunctionNotFoundError"
    end
    if (len(color) != 4):
        throw "Color must be a tuple of 4 integers (RGBA)." from "ValueError"
    end
    for (c in color):
        if (c < 0 || c > 255):
            throw "Color values must be in the range 0-255." from "ValueError"
        end
    end
    libload.call_fn(draw_bounding_box_c, [
        bounding_box.min[0] as float, bounding_box.min[1] as float, bounding_box.min[2] as float,
        bounding_box.max[0] as float, bounding_box.max[1] as float, bounding_box.max[2] as float,
        color[0], color[1], color[2], color[3]
    ])
    return null
end

public final fun check_collision_boxes(box1: BoundingBox, box2: BoundingBox) -> bool:
    /// Checks for collision between two bounding boxes.
    ///     @param box1: BoundingBox - The first bounding box.
    ///     @param box2: BoundingBox - The second bounding box.
    ///     @return: bool - True if the boxes collide, false otherwise.
    if (check_collision_boxes_c == null):
        throw "Function 'bind_CheckCollisionBoxes' not found in the loaded library." from "FunctionNotFoundError"
    end
    result: bool = libload.call_fn(check_collision_boxes_c, [
        box1.min[0] as float, box1.min[1] as float, box1.min[2] as float,
        box1.max[0] as float, box1.max[1] as float, box1.max[2] as float,
        box2.min[0] as float, box2.min[1] as float, box2.min[2] as float,
        box2.max[0] as float, box2.max[1] as float, box2.max[2] as float
    ]) as bool
    return result
end

public final fun check_collision_box_sphere(box: BoundingBox, center: tuple[int | float; 3], radius: int | float) -> bool:
    /// Checks for collision between a bounding box and a sphere.
    ///     @param box: BoundingBox - The bounding box.
    ///     @param center: tuple[int | float; 3] - The center of the sphere.
    ///     @param radius: int | float - The radius of the sphere.
    ///     @return: bool - True if the box and sphere collide, false otherwise.
    if (check_collision_box_sphere_c == null):
        throw "Function 'bind_CheckCollisionBoxSphere' not found in the loaded library." from "FunctionNotFoundError"
    end
    result: bool = libload.call_fn(check_collision_box_sphere_c, [
        box.min[0] as float, box.min[1] as float, box.min[2] as float,
        box.max[0] as float, box.max[1] as float, box.max[2] as float,
        center[0] as float, center[1] as float, center[2] as float,
        radius as float
    ]) as bool
    return result
end

public final LoadModel: function = load_model
public final UnloadModel: function = unload_model
public final UnloadAllModels: function = unload_all_models
public final IsModelValid: function = is_model_valid
public final DrawModel: function = draw_model
public final DrawModelEx: function = draw_model_ex
public final DrawModelWires: function = draw_model_wires
public final DrawModelWiresEx: function = draw_model_wires_ex
public final DrawModelPoints: function = draw_model_points
public final DrawModelPointsEx: function = draw_model_points_ex
public final GetModelBoundingBox: function = get_model_bounding_box
public final DrawBoundingBox: function = draw_bounding_box
public final CheckCollisionBoxes: function = check_collision_boxes
public final CheckCollisionBoxSphere: function = check_collision_box_sphere
