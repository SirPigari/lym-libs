private final load_model_c: &int = libload.get_fn(lib_bind, "bind_LoadModel", ["str"], "int")
private final is_model_valid_c: &int = libload.get_fn(lib_bind, "bind_IsModelValid", ["int"], "bool")
private final unload_model_c: &int = libload.get_fn(lib_bind, "bind_UnloadModel", ["int"], "void")
