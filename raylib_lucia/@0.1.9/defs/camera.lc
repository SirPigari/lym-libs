        throw "Function 'bind_UpdateCameraPro' not found in the loaded library." from "FunctionNotFoundError"
    end
    libload.call_fn(update_camera_pro_c, [
        camera.id,
        movement[0] as float, movement[1] as float, movement[2] as float,
        rotation[0] as float, rotation[1] as float, rotation[2] as float,
        zoom as float
