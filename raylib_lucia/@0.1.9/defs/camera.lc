public final CAMERA_CUSTOM: int = 0             // Camera custom, controlled by user (UpdateCamera() does nothing)
public final CAMERA_FREE: int = 1               // Camera free mode
public final CAMERA_ORBITAL: int = 2            // Camera orbital, around target, zoom supported
public final CAMERA_FIRST_PERSON: int = 3       // Camera first person
public final CAMERA_THIRD_PERSON: int = 4       // Camera third person

public final CAMERA_PERSPECTIVE: int = 0
public final CAMERA_ORTHOGRAPHIC: int = 1

public final typedef struct Camera2D {
