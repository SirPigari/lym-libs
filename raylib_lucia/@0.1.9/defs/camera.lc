public final fun update_camera(camera: Camera, mode: int) -> void:
    /// Updates the camera's position and orientation based on the specified mode.
    ///     @param camera: Camera - The camera to update.
    ///     @param mode: int - The update mode (CAMERA_CUSTOM, CAMERA_FREE, etc.).
    ///     @return: void - No return value.
