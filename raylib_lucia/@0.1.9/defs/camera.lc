        throw "Function 'bind_UpdateCamera' not found in the loaded library." from "FunctionNotFoundError"
    end
    libload.call_fn(update_camera_c, [camera.id, mode])
    return null
end

public final fun update_camera_pro(
    camera: Camera,
    movement: tuple[int | float; 3],
    rotation: tuple[int | float; 3],
    zoom: int | float,
) -> void:
    /// Updates the camera's position and orientation using the provided vectors.
    ///     @param camera: Camera - The camera to update.
    ///     @param movement: tuple[int | float; 3] - The movement vector of the camera.
    ///     @param rotation: tuple[int | float; 3] - The rotation vector of the camera.
    ///     @param zoom: int | float - The zoom level of the camera.
    ///     @return: void - No return value.
